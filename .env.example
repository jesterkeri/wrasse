WRASSE_MEMORY_PATH=.wrasse/memory.db
WRASSE_LLM_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
WRASSE_ESCROW_ADDRESS=
WRASSE_KEYSTORE=.wrasse/keystores/wrasse-deployer
WRASSE_KEYSTORE_PASSWORD_FILE=.wrasse/keystore.password
WRASSE_PROVIDER_A_KEYSTORE=.wrasse/keystores/wrasse-provider-a
WRASSE_TX_DB=.wrasse/transactions.db
WRASSE_DEPLOYMENT_RECORD=deployments/base-sepolia.json
# A second opinion, asked only before abandoning a transaction as replaced. One node's view
# is not the chain, and that verdict is terminal.
BASE_SEPOLIA_FALLBACK_RPC_URL=
# WRASSE_ALLOW_BROADCAST is DELIBERATELY ABSENT. Set it to 1 on the single command that
# should send, never here. A signed transaction moves funds without the key being decrypted
# again, so leaving the opt-in switched on in a file defeats the point of having one.
WRASSE_BUYER_ADDRESS=0x30C95B7eb3E08F83992E803Be2A5AB0E0af93d22
WRASSE_PROVIDER_A_ADDRESS=0x0b920573ADf657f45Fecd9f7e48e66B5535A90C0
WRASSE_PROVIDER_B_ADDRESS=0x88570c4e54cF782c1C9DA24Eebb1E9985AAa3977
WRASSE_PROVIDER_C_ADDRESS=0x8b4C6b36C4Fe37f59F0e5a6c298dd3Ea1ad2E231
